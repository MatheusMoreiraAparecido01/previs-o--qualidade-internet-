<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projeto - Qualidade da Internet</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #eef3f8;
            margin: 0;
            padding: 30px 15px;
            text-align: center;
        }

        .container {
            max-width: 550px;
            margin: auto;
            padding: 25px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 12px #0002;
        }

        h1 {
            color: #1769aa;
        }

        label {
            display: block;
            width: 90%;
            margin: 10px auto 0;
            text-align: left;
            font-size: 14px;
            color: #333;
        }

        input, button {
            width: 90%;
            padding: 12px;
            margin: 4px 0 8px;
            border-radius: 6px;
            box-sizing: border-box;
        }

        input {
            border: 1px solid #aaa;
        }

        button {
            border: none;
            color: white;
            background: #1769aa;
            cursor: pointer;
            margin-top: 14px;
        }

        button:hover {
            background: #12558a;
        }

        #resultado {
            font-weight: bold;
            margin-top: 20px;
            font-size: 18px;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>Qualidade da Internet</h1>

        <p>
            Projeto de análise e previsão da qualidade
            da conexão com a internet.
        </p>

        <form id="formulario">
            <label for="download">Download (Mbps)</label>
            <input id="download" type="number"
                min="0" step="any"
                placeholder="Ex.: 100" required>

            <label for="upload">Upload (Mbps)</label>
            <input id="upload" type="number"
                min="0" step="any"
                placeholder="Ex.: 20" required>

            <label for="ping">Ping (ms)</label>
            <input id="ping" type="number"
                min="0" step="any"
                placeholder="Ex.: 25" required>

            <button type="submit">Avaliar conexão</button>
        </form>

        <p id="resultado"></p>

        <p>
            O objetivo é entender como a velocidade
            e o tempo de resposta influenciam a conexão.
        </p>
    </div>

    <script>
        function classificarConexao(download, upload, ping) {
            if (download >= 100 && upload >= 20 && ping <= 30) {
                return "Excelente";
            } else if (download >= 30 && upload >= 5 && ping <= 60) {
                return "Boa";
            } else if (download >= 10 && ping <= 100) {
                return "Regular";
            }
            return "Ruim";
        }

        const cores = {
            "Excelente": "green",
            "Boa": "#2e7d32",
            "Regular": "orange",
            "Ruim": "red"
        };

        document.getElementById("formulario")
            .addEventListener("submit", function (event) {
                event.preventDefault();

                const resultado = document.getElementById("resultado");

                const download = Number(document.getElementById("download").value);
                const upload = Number(document.getElementById("upload").value);
                const ping = Number(document.getElementById("ping").value);

                if (isNaN(download) || isNaN(upload) || isNaN(ping) ||
                    download < 0 || upload < 0 || ping < 0) {
                    resultado.style.color = "red";
                    resultado.textContent = "Informe valores válidos.";
                    return;
                }

                const qualidade = classificarConexao(download, upload, ping);

                resultado.style.color = cores[qualidade];
                resultado.textContent = "Qualidade estimada: " + qualidade;
            });
    </script>
</body>
</html>
